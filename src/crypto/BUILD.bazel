load("//build_defs:cc.bzl", "gravesentinel_cc_library")

package(default_visibility = ["//visibility:private"])

gravesentinel_cc_library(
    name = "blake3",
    srcs = ["blake3.cxx"],
    hdrs = ["blake3.hxx"],
    deps = [
        "//src/protocol:protocol",
        "@blake3//:blake3",
    ],
    visibility = [
        "//src/core:__pkg__",
        "//src/manifest:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

filegroup(
    name = "format_sources",
    srcs = [
        "blake3.cxx",
        "blake3.hxx",
    ],
    visibility = ["//scripts:__pkg__"],
)
