load("//build_defs:cc.bzl", "gravesentinel_cc_library")

package(default_visibility = ["//visibility:private"])

gravesentinel_cc_library(
    name = "ccm_core",
    hdrs = [
        "contracts.hxx",
        "errors.hxx",
    ],
    deps = ["//src/protocol:protocol"],
    visibility = [
        "//src/chunking:__pkg__",
        "//src/hypervisor:__pkg__",
        "//src/storage:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "checkpoint_creator",
    srcs = ["checkpoint_creator.cxx"],
    hdrs = ["checkpoint_creator.hxx"],
    deps = [
        ":ccm_core",
        "//src/chunking:snapshot_chunker",
        "//src/manifest:manifest",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "restore_coordinator",
    srcs = ["restore_coordinator.cxx"],
    hdrs = ["restore_coordinator.hxx"],
    deps = [
        ":ccm_core",
        "//src/chunking:snapshot_chunker",
        "//src/manifest:manifest",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "checkpoint_service",
    srcs = ["checkpoint_service.cxx"],
    hdrs = ["checkpoint_service.hxx"],
    deps = [
        ":ccm_core",
        ":checkpoint_creator",
        ":restore_coordinator",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "blake3_hasher",
    srcs = ["blake3_hasher.cxx"],
    hdrs = ["blake3_hasher.hxx"],
    deps = [
        ":ccm_core",
        "//src/crypto:blake3",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

filegroup(
    name = "format_sources",
    srcs = [
        "blake3_hasher.cxx",
        "blake3_hasher.hxx",
        "checkpoint_creator.cxx",
        "checkpoint_creator.hxx",
        "checkpoint_service.cxx",
        "checkpoint_service.hxx",
        "contracts.hxx",
        "errors.hxx",
        "restore_coordinator.cxx",
        "restore_coordinator.hxx",
    ],
    visibility = ["//scripts:__pkg__"],
)
