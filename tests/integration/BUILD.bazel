test_suite(
    name = "stage13_acceptance",
    tests = [
        ":hypervisor_crash_recovery_e2e",
        ":hypervisor_four_cpu_e2e",
        ":hypervisor_scheduler_e2e",
    ],
    tags = ["manual"],
)

filegroup(
    name = "format_sources",
    srcs = [
        "fault_hypervisor_main.cxx",
        "fault_injecting_file_operations.cxx",
        "fault_injecting_file_operations.hxx",
        "hypervisor_crash_recovery_driver.cxx",
        "hypervisor_e2e_driver.cxx",
        "hypervisor_four_cpu_driver.cxx",
        "hypervisor_lifecycle_test.cxx",
        "podman_adapter_smoke_driver.cxx",
    ],
    visibility = ["//scripts:__pkg__"],
)

filegroup(
    name = "integration_test_documentation",
    srcs = ["README.md"],
)
