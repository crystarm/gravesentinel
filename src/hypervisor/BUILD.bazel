load(
    "//build_defs:cc.bzl",
    "gravesentinel_cc_binary",
    "gravesentinel_cc_library",
)

package(default_visibility = ["//visibility:private"])

gravesentinel_cc_library(
    name = "linux_runtime",
    srcs = [
        "linux_affinity_controller.cxx",
        "posix_process_runner.cxx",
    ],
    hdrs = [
        "linux_affinity_controller.hxx",
        "posix_process_runner.hxx",
    ],
    deps = ["//src/core:ccm_core"],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/integration:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "podman_adapter",
    srcs = ["podman_adapter.cxx"],
    hdrs = ["podman_adapter.hxx"],
    deps = [
        "//src/core:ccm_core",
        "@nlohmann_json//:json",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/integration:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "rpc_handler",
    srcs = ["rpc_handler.cxx"],
    hdrs = ["rpc_handler.hxx"],
    deps = [
        "//src/core:ccm_core",
        "//src/ipc:ipc_codec",
        "//src/ipc:operation_store",
        "@nlohmann_json//:json",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

gravesentinel_cc_library(
    name = "application",
    srcs = ["application.cxx"],
    hdrs = ["application.hxx"],
    deps = [
        "//src/chunking:snapshot_chunker",
        "//src/core:blake3_hasher",
        "//src/core:checkpoint_creator",
        "//src/core:checkpoint_service",
        "//src/core:restore_coordinator",
        "//src/hypervisor:linux_runtime",
        "//src/hypervisor:podman_adapter",
        "//src/hypervisor:rpc_handler",
        "//src/ipc:ipc_server",
        "//src/ipc:operation_store",
        "//src/storage:filesystem_storage",
        "@nlohmann_json//:json",
    ],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/integration:__pkg__",
    ],
)

gravesentinel_cc_binary(
    name = "gravesentinel_hypervisor",
    srcs = ["main.cxx"],
    deps = [":application"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "format_sources",
    srcs = [
        "application.cxx",
        "application.hxx",
        "linux_affinity_controller.cxx",
        "linux_affinity_controller.hxx",
        "main.cxx",
        "podman_adapter.cxx",
        "podman_adapter.hxx",
        "posix_process_runner.cxx",
        "posix_process_runner.hxx",
        "rpc_handler.cxx",
        "rpc_handler.hxx",
    ],
    visibility = ["//scripts:__pkg__"],
)
