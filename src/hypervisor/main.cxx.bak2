#include "src/chunking/snapshot_chunker.hxx"
#include "src/core/blake3_hasher.hxx"
#include "src/core/checkpoint_service.hxx"
#include "src/hypervisor/linux_affinity_controller.hxx"
#include "src/hypervisor/podman_adapter.hxx"
#include "src/hypervisor/posix_process_runner.hxx"
#include "src/ipc/codec.hxx"
#include "src/ipc/operation_store.hxx"
#include "src/ipc/server.hxx"
#include "src/storage/filesystem_storage.hxx"

#include <nlohmann/json.hpp>
#include <atomic>
#include <chrono>
#include <cstddef>
#include <cstdint>
#include <csignal>
#include <cstdlib>
#include <filesystem>
#include <iostream>
#include <string>
#include <thread>
#include <unistd.h>

namespace {
volatile std::sig_atomic_t stop_requested = 0;
void request_stop(int) { stop_requested = 1; }

struct Config {
  std::string socket{"/run/gravesentinel/hypervisor.sock"};
  std::string storage{"/var/lib/gravesentinel"};
  std::string log{"/var/log/gravesentinel"};
  std::string runtime{"podman-criu"};
  unsigned mode{0660};
};
bool parse(int argc, char **argv, Config &c) {
  for (int i = 1; i < argc; ++i) {
    const std::string arg(argv[i]);
    if (arg == "--help") {
      std::cout << "gravesentinel_hypervisor [--socket PATH] [--storage DIR] [--log DIR] [--runtime-profile NAME] [--socket-mode OCTAL]\n";
      std::exit(0);
    }
    if (i + 1 >= argc) return false;
    const std::string value(argv[++i]);
    if (arg == "--socket") c.socket = value;
    else if (arg == "--storage") c.storage = value;
    else if (arg == "--log") c.log = value;
    else if (arg == "--runtime-profile") c.runtime = value;
    else if (arg == "--socket-mode") {
      try { c.mode = static_cast<unsigned>(std::stoul(value, nullptr, 8)); }
      catch (...) { return false; }
    } else return false;
  }
  return !c.socket.empty() && !c.storage.empty() && !c.log.empty() &&
         !c.runtime.empty() && (c.mode & ~0777U) == 0;
}

class SystemClock final : public gravesentinel::ccm::IClock {
public:
  WallTime wall_now() const noexcept override { return std::chrono::system_clock::now(); }
  MonotonicTime monotonic_now() const noexcept override { return std::chrono::steady_clock::now(); }
};
class IdGenerator final : public gravesentinel::ccm::IIdGenerator {
public:
  gravesentinel::ccm::CheckpointResult<gravesentinel::ccm::CheckpointId> new_checkpoint_id() override {
    return gravesentinel::ccm::CheckpointId::create("checkpoint-" + next());
  }
  gravesentinel::ccm::CheckpointResult<gravesentinel::ccm::OperationId> new_operation_id() override {
    return gravesentinel::ccm::OperationId::create("operation-" + next());
  }
private:
  std::string next() { return std::to_string(::getpid()) + "-" + std::to_string(++counter_); }
  std::atomic<unsigned long long> counter_{0};
};
class StderrLogger final : public gravesentinel::ccm::ILogger {
public:
  void log(gravesentinel::ccm::LogLevel level, std::string_view message,
           std::span<const gravesentinel::ccm::LogField>) noexcept override {
    const char *prefix = level == gravesentinel::ccm::LogLevel::error ? "ERROR" :
      level == gravesentinel::ccm::LogLevel::warning ? "WARN" :
      level == gravesentinel::ccm::LogLevel::debug ? "DEBUG" : "INFO";
    std::cerr << "[" << prefix << "] " << message << '\n';
  }
};

std::string error_text(const gravesentinel::ccm::CheckpointErrorDetail &error) {
  return std::string("service_") + std::to_string(static_cast<unsigned>(error.code)) + ":" + error.diagnostic;
}
std::expected<gravesentinel::ccm::ContainerId, std::string> container_id(const nlohmann::json &params) {
  if (!params.is_object() || !params.contains("container_id") || !params["container_id"].is_string())
    return std::unexpected("container_id must be a string");
  auto id = gravesentinel::ccm::ContainerId::create(params["container_id"].get<std::string>());
  if (!id || !gravesentinel::ipc::valid_identifier(id->value())) return std::unexpected("invalid container_id");
  return *id;
}
}

int main(int argc, char **argv) {
  Config config;
  if (!parse(argc, argv, config)) { std::cerr << "invalid arguments (use --help)\n"; return 2; }
  if (config.runtime != "podman-criu" && config.runtime != "podman-criu-rootful-v1") {
    std::cerr << "unsupported runtime profile\n"; return 2;
  }
  std::error_code ec;
  for (const auto &path : {std::filesystem::path(config.socket).parent_path(), std::filesystem::path(config.storage), std::filesystem::path(config.log)}) {
    if (!path.empty()) std::filesystem::create_directories(path, ec);
    if (ec) { std::cerr << "cannot create configured directory: " << ec.message() << '\n'; return 3; }
  }
  std::filesystem::create_directories(config.storage + "/checkpoint-data", ec);
  if (ec) { std::cerr << "cannot create storage data directory: " << ec.message() << '\n'; return 3; }
  std::filesystem::create_directories(config.storage + "/staging", ec);
  if (ec) { std::cerr << "cannot create staging directory: " << ec.message() << '\n'; return 3; }

  using namespace gravesentinel::ccm;
  auto storage_result = FilesystemStorage::open(config.storage + "/checkpoint-data");
  if (!storage_result) { std::cerr << "cannot initialize checkpoint storage: " << storage_result.error().diagnostic << '\n'; return 4; }
  auto storage = std::move(*storage_result);
  SystemClock clock;
  SteadyTimer timer;
  IdGenerator ids;
  StderrLogger logger;
  LinuxAffinityController affinity;
  PosixProcessRunner runner;
  PodmanAdapterConfig runtime_config;
  runtime_config.podman_executable = "/usr/bin/podman";
  runtime_config.criu_executable = "/usr/bin/criu";
  runtime_config.staging_root = config.storage + "/staging";
  PodmanAdapter podman(runner, affinity, logger, std::move(runtime_config));
  Blake3Hasher hasher;
  SnapshotChunker chunker(hasher);
  CheckpointCreator creator(*storage, podman, chunker, clock, ids, logger);
  RestoreCoordinator restore(*storage, podman, hasher, logger);
  CheckpointOperations operations(creator, restore);
  CheckpointService service(operations, clock, timer, ids, affinity, logger);

  std::signal(SIGTERM, request_stop);
  std::signal(SIGINT, request_stop);
  gravesentinel::ipc::OperationStore operation_store(
      config.storage + "/operations.jsonl",
      [&service](const gravesentinel::ipc::OperationView &operation)
          -> std::expected<std::string, gravesentinel::ipc::StoreError> {
        auto request = RequestId::create(operation.request_id);
        auto container = ContainerId::create(operation.container_id);
        auto op = OperationId::create(operation.operation_id);
        if (!request || !container || !op)
          return std::unexpected(gravesentinel::ipc::StoreError{"invalid persisted operation identifiers"});
        CheckpointResult<void> result = std::unexpected(CheckpointErrorDetail{StableErrorCode::internal, "unsupported operation", false, {}});
        if (operation.method == "SubmitCreateCheckpoint")
          result = service.create_checkpoint(*container, *request, *op);
        else if (operation.method == "SubmitRestoreOrRestart")
          result = service.restore_or_restart(*container, *request, *op);
        if (!result) return std::unexpected(gravesentinel::ipc::StoreError{std::string("service_error_code_") + std::to_string(static_cast<unsigned>(result.error().code))});
        return std::string("ok");
      });

  const auto handler = [&service, &operation_store](const nlohmann::json &request) -> nlohmann::json {
    const auto method = request.at("method").get<std::string>();
    const auto request_id_text = request.at("request_id").get<std::string>();
    const auto params = request.at("params");
    if (method == "Handshake")
      return {{"protocol_version", gravesentinel::ipc::protocol_version}, {"service", "gravesentinel_hypervisor"}};
    if (method == "GetHealth")
      return {{"status", "healthy"}, {"queue", "available"}, {"protocol_version", gravesentinel::ipc::protocol_version}};
    if (method == "GetOperation") {
      if (!params.is_object() || !params.contains("operation_id") || !params["operation_id"].is_string())
        return {{"ok", false}, {"error", "operation_id must be a string"}};
      auto found = operation_store.get(params["operation_id"].get<std::string>());
      if (!found) return {{"ok", false}, {"error", found.error().message}};
      return {{"operation_id", found->operation_id}, {"request_id", found->request_id},
              {"method", found->method}, {"container_id", found->container_id},
              {"state", gravesentinel::ipc::state_name(found->state)}, {"result", found->result}};
    }
    auto request_id = RequestId::create(request_id_text);
    if (!request_id || !gravesentinel::ipc::valid_identifier(request_id_text))
      return {{"ok", false}, {"error", "invalid request_id"}};
    if (method == "Register") {
      auto container = container_id(params);
      if (!container || !params.contains("runtime_container") || !params["runtime_container"].is_string() ||
          !params.contains("interval_seconds") || !params["interval_seconds"].is_number_integer() ||
          !params.contains("keep_last") || !params["keep_last"].is_number_unsigned() ||
          !params.contains("container_cpu") || !params["container_cpu"].is_number_unsigned() ||
          !params.contains("checkpoint_cpu") || !params["checkpoint_cpu"].is_number_unsigned())
        return {{"ok", false}, {"error", "invalid Register parameters"}};
      auto runtime = RuntimeContainerRef::create(params["runtime_container"].get<std::string>());
      const auto interval = params["interval_seconds"].get<std::int64_t>();
      const auto keep = params["keep_last"].get<std::uint64_t>();
      const auto cpu = params["container_cpu"].get<std::uint64_t>();
      const auto checkpoint_cpu = params["checkpoint_cpu"].get<std::uint64_t>();
      if (!runtime || interval <= 0 || interval > 86400 * 365 || keep == 0 || keep > 1000 || cpu > UINT32_MAX || checkpoint_cpu > UINT32_MAX)
        return {{"ok", false}, {"error", "Register values out of range"}};
      ContainerRegistration registration{*container, *runtime,
        CheckpointConfig{std::chrono::seconds{interval}, static_cast<std::size_t>(keep), static_cast<std::uint32_t>(cpu), static_cast<std::uint32_t>(checkpoint_cpu)}, {}, {}};
      auto valid = validate_container_registration(registration);
      if (!valid) return {{"ok", false}, {"error", valid.error().diagnostic}};
      auto result = service.register_container(registration, *request_id);
      if (!result) return {{"ok", false}, {"error", error_text(result.error())}};
      return {{"ok", true}};
    }
    if (method == "Unregister") {
      auto container = container_id(params);
      if (!container) return {{"ok", false}, {"error", container.error()}};
      auto result = service.unregister_container(*container, *request_id);
      if (!result) return {{"ok", false}, {"error", error_text(result.error())}};
      return {{"ok", true}};
    }
    if (method == "SubmitCreateCheckpoint" || method == "SubmitRestoreOrRestart") {
      auto container = container_id(params);
      if (!container) return {{"ok", false}, {"error", container.error()}};
      // Only public, non-secret operation parameters enter the durable request digest.
      const auto canonical = nlohmann::json{{"method", method}, {"container_id", container->value()}}.dump();
      auto submitted = operation_store.submit(request_id_text, method, container->value(), canonical);
      if (!submitted) return {{"ok", false}, {"error", submitted.error().message}};
      return {{"operation_id", submitted->operation_id}, {"duplicate", submitted->duplicate}};
    }
    return {{"ok", false}, {"error", "unknown method"}};
  };
  std::cerr << "gravesentinel_hypervisor: listening on " << config.socket << '\n';
  gravesentinel::ipc::ServerConfig server{config.socket, config.storage + "/hypervisor.lock", config.mode, true};
  const int result = gravesentinel::ipc::serve(server, handler, &stop_requested);
  operation_store.stop();
  (void)service.shutdown();
  return result;
}
