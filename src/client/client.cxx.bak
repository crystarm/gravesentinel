#include "src/client/scheduler_client.hxx"
#include "src/ipc/codec.hxx"
#include <nlohmann/json.hpp>
#include <sys/socket.h>
#include <sys/un.h>
#include <poll.h>
#include <unistd.h>
#include <cerrno>
#include <algorithm>
#include <atomic>
#include <cstring>
#include <memory>
#include <utility>

namespace gravesentinel::ccm {
namespace { std::string next_request_id() { static std::atomic<unsigned long long> sequence{0}; return "client-" + std::to_string(::getpid()) + "-" + std::to_string(++sequence); } }
struct SchedulerClient::Impl {
  std::string path;
  std::chrono::milliseconds timeout;
  int fd{-1};
};
SchedulerClient::SchedulerClient(std::string path, std::chrono::milliseconds timeout)
    : impl_(new Impl{std::move(path), timeout, -1}) {}
SchedulerClient::~SchedulerClient() { if (impl_) { if (impl_->fd >= 0) ::close(impl_->fd); delete impl_; } }
SchedulerClient::SchedulerClient(SchedulerClient &&other) noexcept : impl_(std::exchange(other.impl_, nullptr)) {}
SchedulerClient &SchedulerClient::operator=(SchedulerClient &&other) noexcept {
  if (this != &other) { if (impl_) { if (impl_->fd >= 0) ::close(impl_->fd); delete impl_; } impl_ = std::exchange(other.impl_, nullptr); }
  return *this;
}
std::expected<void, RpcFailure> SchedulerClient::connect() {
  if (!impl_) return std::unexpected(RpcFailure{"client has been moved"});
  if (impl_->fd >= 0) { ::close(impl_->fd); impl_->fd = -1; }
  const int fd = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
  if (fd < 0) return std::unexpected(RpcFailure{std::strerror(errno)});
  sockaddr_un address{}; address.sun_family = AF_UNIX;
  if (impl_->path.size() >= sizeof(address.sun_path)) { ::close(fd); return std::unexpected(RpcFailure{"socket path too long"}); }
  std::memcpy(address.sun_path, impl_->path.c_str(), impl_->path.size() + 1);
  if (::connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) != 0) {
    const auto message = std::string(std::strerror(errno)); ::close(fd); return std::unexpected(RpcFailure{message});
  }
  impl_->fd = fd;
  auto handshake = call("Handshake", "handshake-" + std::to_string(::getpid()));
  if (!handshake) { ::close(impl_->fd); impl_->fd = -1; return std::unexpected(handshake.error()); }
  if (!handshake->payload.contains("protocol_version") ||
      !handshake->payload["protocol_version"].is_number_unsigned() ||
      handshake->payload["protocol_version"].get<unsigned>() != gravesentinel::ipc::protocol_version) {
    ::close(impl_->fd); impl_->fd = -1;
    return std::unexpected(RpcFailure{"hypervisor protocol handshake mismatch"});
  }
  return {};
}
std::expected<RpcReply, RpcFailure> SchedulerClient::call(std::string_view method, std::string request_id, nlohmann::json params) {
  if (!impl_) return std::unexpected(RpcFailure{"client has been moved"});
  nlohmann::json request{{"version", gravesentinel::ipc::protocol_version}, {"method", method}, {"request_id", request_id}, {"params", params}};
  auto bytes = gravesentinel::ipc::encode(request);
  if (!bytes) return std::unexpected(RpcFailure{bytes.error().message});
  for (int attempt = 0; attempt < 2; ++attempt) {
    if (impl_->fd < 0) { auto c = connect(); if (!c) { if (attempt == 0) continue; return std::unexpected(c.error()); } }
    const auto sent = ::send(impl_->fd, bytes->data(), bytes->size(), MSG_NOSIGNAL);
    if (sent != static_cast<ssize_t>(bytes->size())) {
      ::close(impl_->fd); impl_->fd = -1; if (attempt == 0) continue;
      return std::unexpected(RpcFailure{"send failed"});
    }
    pollfd pfd{impl_->fd, POLLIN, 0};
    const auto wait = static_cast<int>(std::clamp<long long>(impl_->timeout.count(), 1, 2147483647));
    const auto ready = ::poll(&pfd, 1, wait);
    if (ready <= 0 || (pfd.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
      ::close(impl_->fd); impl_->fd = -1; if (attempt == 0) continue;
      return std::unexpected(RpcFailure{"RPC deadline exceeded or connection closed"});
    }
    char buffer[gravesentinel::ipc::max_message_bytes + 1];
    const auto n = ::recv(impl_->fd, buffer, sizeof(buffer), 0);
    if (n <= 0 || static_cast<std::size_t>(n) > gravesentinel::ipc::max_message_bytes) {
      ::close(impl_->fd); impl_->fd = -1; if (attempt == 0) continue;
      return std::unexpected(RpcFailure{"invalid RPC response length"});
    }
    auto response = gravesentinel::ipc::decode(std::string_view(buffer, static_cast<std::size_t>(n)));
    if (!response) return std::unexpected(RpcFailure{response.error().message});
    if (!response->contains("ok") || !(*response)["ok"].is_boolean() || !(*response)["ok"].get<bool>())
      return std::unexpected(RpcFailure{response->value("error", std::string("RPC failed"))});
    if (!response->contains("request_id") || (*response)["request_id"] != "response")
      return std::unexpected(RpcFailure{"invalid RPC response envelope"});
    return RpcReply{std::move(*response)};
  }
  return std::unexpected(RpcFailure{"RPC failed after reconnect"});
}
bool SchedulerClient::register_container(const ContainerRegistration &r, const RequestId &id) {
  nlohmann::json p{{"container_id", r.container_id.value()}, {"runtime_container", r.runtime_container.value()},
    {"interval_seconds", r.checkpoint.interval.count()}, {"keep_last", r.checkpoint.keep_last},
    {"container_cpu", r.checkpoint.container_cpu}, {"checkpoint_cpu", r.checkpoint.checkpoint_cpu}};
  return static_cast<bool>(call("Register", id.value(), std::move(p)));
}
bool SchedulerClient::register_container(const ContainerRegistration &r) { auto id = RequestId::create(next_request_id()); return id && register_container(r, *id); }
bool SchedulerClient::unregister_container(const ContainerId &id, const RequestId &request_id) {
  return static_cast<bool>(call("Unregister", request_id.value(), {{"container_id", id.value()}}));
}
bool SchedulerClient::unregister_container(const ContainerId &id) { auto request = RequestId::create(next_request_id()); return request && unregister_container(id, *request); }
bool SchedulerClient::create_checkpoint(const ContainerId &id) { auto request = RequestId::create(next_request_id()); return request && static_cast<bool>(submit_create_checkpoint(id, *request)); }
bool SchedulerClient::restore_or_restart(const ContainerId &id) { auto request = RequestId::create(next_request_id()); return request && static_cast<bool>(submit_restore_or_restart(id, *request)); }
std::expected<std::string, RpcFailure> SchedulerClient::submit_create_checkpoint(const ContainerId &id, const RequestId &request) {
  auto r = call("SubmitCreateCheckpoint", request.value(), {{"container_id", id.value()}});
  if (!r) return std::unexpected(r.error()); return r->payload.value("operation_id", std::string{});
}
std::expected<std::string, RpcFailure> SchedulerClient::submit_restore_or_restart(const ContainerId &id, const RequestId &request) {
  auto r = call("SubmitRestoreOrRestart", request.value(), {{"container_id", id.value()}});
  if (!r) return std::unexpected(r.error()); return r->payload.value("operation_id", std::string{});
}
std::expected<RpcReply, RpcFailure> SchedulerClient::get_operation(std::string_view id) {
  return call("GetOperation", "poll-" + std::string(id), {{"operation_id", id}});
}
std::expected<RpcReply, RpcFailure> SchedulerClient::get_health() { return call("GetHealth", "health-" + std::to_string(::getpid())); }
}
