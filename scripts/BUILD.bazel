package(default_visibility = ["//visibility:private"])

sh_test(
    name = "clang_format_test",
    srcs = ["check_clang_format.sh"],
    args = [
        "$(locations //src/chunking:format_sources)",
        "$(locations //src/client:format_sources)",
        "$(locations //src/ipc:format_sources)",
        "$(locations //src/core:format_sources)",
        "$(locations //src/crypto:format_sources)",
        "$(locations //src/hypervisor:format_sources)",
        "$(locations //src/manifest:format_sources)",
        "$(locations //:public_client_headers)",
        "$(locations //src/protocol:format_sources)",
        "$(locations //src/scheduler_client:format_sources)",
        "$(locations //src/storage:format_sources)",
        "$(locations //tests/integration:format_sources)",
        "$(locations //tests/integration/fixture:format_sources)",
        "$(locations //tests/unit:format_sources)",
    ],
    data = [
        "//:clang_format_config",
        "//src/chunking:format_sources",
        "//src/client:format_sources",
        "//src/ipc:format_sources",
        "//src/core:format_sources",
        "//src/crypto:format_sources",
        "//src/hypervisor:format_sources",
        "//src/manifest:format_sources",
        "//:public_client_headers",
        "//src/protocol:format_sources",
        "//src/scheduler_client:format_sources",
        "//src/storage:format_sources",
        "//tests/integration:format_sources",
        "//tests/integration/fixture:format_sources",
        "//tests/unit:format_sources",
    ],
    size = "small",
    visibility = ["//:__pkg__"],
)

sh_binary(
    name = "check_scheduler_client_boundary",
    srcs = ["check_scheduler_client_boundary.sh"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "check_scheduler_client_consumer_runtime",
    srcs = ["check_scheduler_client_consumer_runtime.sh"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "check_testbed",
    srcs = ["check_testbed.sh"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "release_gate",
    srcs = ["release_gate.sh"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "scripts",
    srcs = [
        "check_clang_format.sh",
        "check_scheduler_client_boundary.sh",
        "check_scheduler_client_consumer_runtime.sh",
        "check_testbed.sh",
        "release_gate.sh",
    ],
)
