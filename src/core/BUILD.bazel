load("//build_defs:cc.bzl", "gravesentinel_cc_library")

package(default_visibility = ["//visibility:private"])

gravesentinel_cc_library(
    name = "ccm_core",
    hdrs = [
        "contracts.hpp",
        "errors.hpp",
    ],
    deps = ["//src/protocol:protocol"],
    visibility = [
        "//src/hypervisor:__pkg__",
        "//tests/unit:__pkg__",
    ],
)

filegroup(
    name = "format_sources",
    srcs = [
        "contracts.hpp",
        "errors.hpp",
    ],
    visibility = ["//scripts:__pkg__"],
)
