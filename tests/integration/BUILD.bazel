    ],
    timeout = "eternal",
)

sh_test(
    name = "hypervisor_crash_recovery_e2e",
    srcs = ["hypervisor_crash_recovery_e2e.sh"],
    args = [
        "--hypervisor",
        "$(location //src/hypervisor:gravesentinel_hypervisor)",
        "--fault-hypervisor",
        "$(location :fault_hypervisor)",
        "--driver",
        "$(location :hypervisor_crash_recovery_driver)",
